        "/admin/events": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Menambahkan event konser baru ke dalam sistem beserta kategori tiket awal.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Admin - Events Management"
                ],
                "summary": "Membuat event/konser baru (Admin)",
