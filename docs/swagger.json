        "/auth/register/request-otp": {
            "post": {
                "description": "Mengirimkan 6 digit kode OTP registrasi ke email pengguna.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth - User"
                ],
                "summary": "Meminta kode OTP untuk registrasi",
                "parameters": [
                    {
                        "description": "Register Request OTP Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RegisterRequestOTPInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kode OTP registrasi berhasil dikirim",
                        "schema": {
                            "$ref": "#/definitions/models.APIResponse"
                        }
                    },
                    "400": {
                        "description": "Payload tidak valid / Email terdaftar",
                        "schema": {
                            "$ref": "#/definitions/models.APIResponse"
                        }
                    },
                    "429": {
                        "description": "Cooldown OTP (tunggu 60s)",
                        "schema": {
                            "$ref": "#/definitions/models.APIResponse"
                        }
                    }
                }
            }
        },
